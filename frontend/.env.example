# Backend API base URL (no trailing slash). Local default:
VITE_API_URL=http://localhost:3000

# Optional: pre-filled cleanup secret for "Free server disk space" (same as backend CLEANUP_DISK_SECRET).
# WARNING: embedded in the built frontend bundle — use only for private/internal deployments, or leave unset and paste at click time.
# VITE_CLEANUP_DISK_SECRET=

# Production: point at your deployed API, e.g.
# VITE_API_URL=https://api.yourdomain.com
