PORT=3000

# Comma-separated browser origins allowed to call this API (CORS).
# Local development (copy to .env as-is):
CORS_ORIGINS=http://localhost:5173

# If you also deploy the frontend, append its origin, e.g.:
# CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# Max size per uploaded file (solution ZIP, each student ZIP, Excel), in megabytes.
# Whole request must also fit your reverse proxy (e.g. Nginx client_max_body_size).
# MAX_UPLOAD_MB=500

# Create React App / webpack dev server heap (MB) when running "react-scripts start" on the server.
# Lower on 1–2 GB RAM instances if the host OOMs; raise on larger instances if webpack exits early.
# WEBPACK_DEV_HEAP_MB=1024

# Per-GET timeout (ms) when probing the student dev server; CRA first compile can exceed a few seconds.
# SERVER_READY_TIMEOUT_MS=25000

# Max seconds to wait for student dev server (CRA compile). Default 720.
# SERVER_READY_MAX_WAIT_SEC=720

# Playwright navigation timeout per route (ms). Heavy SPAs may need 90s+.
# PLAYWRIGHT_GOTO_TIMEOUT_MS=90000

# npm install in temp dirs (CRA local node_modules): avoid OOM exit 137 on small EC2.
# NPM_INSTALL_SERIALIZE=1   # default: one install at a time (set 0/false to allow parallel — more RAM)
# NPM_INSTALL_HEAP_MB=1024  # Node --max-old-space-size for the npm child (default 1024; try 512 if host still OOMs)
# NPM_INSTALL_OMIT_OPTIONAL=1  # default: temp CRA `npm install` skips optional deps (smaller). NOT used for master_project (Rollup/Vite need @rollup/* natives).
# NPM_INSTALL_EXTRA_FLAGS=   # optional extra npm args (space-separated)
# NPM_CONFIG_MAXSOCKETS=1   # default via code; lower npm network parallelism
# NPM_CONFIG_FOREGROUND_SCRIPTS=true  # default via code; run lifecycle scripts sequentially

# If set to 1/true, every student project runs npm install in its own folder (no symlink to master_project).
# CRA uses this automatically; set this to debug Vite projects that misbehave with the shared junction.
# DISABLE_SHARED_NODE_MODULES=
